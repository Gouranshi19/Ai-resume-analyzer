SECRET_KEY=your-secret-key

DEBUG=True

ALLOWED_HOSTS=127.0.0.1,localhost

DB_ENGINE=django.db.backends.postgresql
DB_NAME=cv_insight_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=127.0.0.1
DB_PORT=5432

GOOGLE_CLIENT_ID=your_google_oauth_client_id
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Gemini API key for server-side AI resume suggestions
GEMINI_API_KEY=your_gemini_api_key
# Fast model for resume feedback; can be overridden as needed
GEMINI_MODEL=gemini-3.5-flash-lite

# Set DEBUG=False and real host/origin values in production.
# Configure HTTPS proxy handling according to your hosting platform.

